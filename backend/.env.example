# Server Configuration
PORT=3000

# ----- Base de Datos (PostgreSQL) -----
# Usadas por TypeORM en typeorm.config.ts y app.module.ts
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_password_aqui
DATABASE_NAME=eventos_academicos_db

# ----- Seguridad JWT -----
JWT_SECRET=tu_secreto_jwt_muy_largo_y_seguro
JWT_EXPIRATION=24h

# ----- Cifrado de Firmas (AES-256) -----
STATE_ENCRYPTION_KEY=una_clave_de_exactamente_32_caracteres

# ----- Hashing de Contraseñas (bcrypt) -----
BCRYPT_SALT_ROUNDS=10

# ----- CORS (Frontend) -----
FRONTEND_URL=http://localhost:5173

# ----- Configuración de Correo (SMTP) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=correo.example.com (correo)
MAIL_PASSWORD=tu_password_smtp
MAIL_FROM="Usuario" <correo.example.com>
MAIL_DAILY_LIMIT=250

# ----- Certificados (Seguridad HMAC) -----
# Clave secreta para HMAC-SHA256 de integridad de PDFs. Mínimo 32 caracteres.
CERT_HMAC_SECRET=cambia_esto_por_una_clave_secreta_de_minimo_32_chars
